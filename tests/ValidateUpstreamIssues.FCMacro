"""Quick issue regressions against the existing fork; does not build/install code.

Set FREECAD_PLUS_SOURCE and FREECAD_PLUS_VALIDATION_DIR; use isolated preferences.
Mirror tests load from source so an old binary can demonstrate the regression.
"""
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import traceback
import unittest

import FreeCAD as App
import FreeCADGui as Gui
from PySide import QtCore, QtWidgets

output = Path(os.environ["FREECAD_PLUS_VALIDATION_DIR"])
output.mkdir(parents=True, exist_ok=True)
source = Path(os.environ["FREECAD_PLUS_SOURCE"])
report = {"version": App.Version(), "application": App.ConfigGet("AppHomePath"), "suites": []}
window = Gui.getMainWindow()
window.setAttribute(QtCore.Qt.WA_DontShowOnScreen, True)
window.show()
Gui.updateGui()
try:
    paths = [source / name for name in os.environ.get("FREECAD_PLUS_ISSUE_TESTS",
        "src/Mod/Part/parttests/TestPartMirror.py,src/Mod/CAM/CAMTests/TestPathOpUtil.py,"
        "tests/TestIssueQuantityInput.py,tests/TestIssueTreeSelection.py,"
        "src/Mod/PartDesign/PartDesignTests/TestExtrudeTaskPanel.py,tests/TestIssueMirrorGui.py,"
        "tests/TestIssueSurfaceAvoidance.py"
    ).split(",")]
    for path in paths:
        spec = importlib.util.spec_from_file_location(path.stem, path)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        with (output / (path.stem + ".log")).open("w", encoding="utf-8", buffering=1) as stream:
            result = unittest.TextTestRunner(stream=stream, verbosity=2).run(
                unittest.defaultTestLoader.loadTestsFromModule(module))
        report["suites"].append({
            "name": path.stem, "source": str(path),
            "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
            "run": result.testsRun, "passed": result.wasSuccessful(),
            "failures": [(str(t), msg) for t, msg in result.failures],
            "errors": [(str(t), msg) for t, msg in result.errors],
            "skipped": [(str(t), msg) for t, msg in result.skipped],
        })
    report["passed"] = all(s["passed"] and not s["skipped"] for s in report["suites"])
except BaseException:
    report["passed"] = False
    report["harness_error"] = traceback.format_exc()
finally:
    report["tests_run"] = sum(s["run"] for s in report["suites"])
    (output / "results.json").write_text(json.dumps(report, indent=2), encoding="utf-8")
    (output / "validation.done").write_text("PASS" if report["passed"] else "FAIL")
    for doc in list(App.listDocuments().values()):
        App.closeDocument(doc.Name)
    QtCore.QTimer.singleShot(100, QtWidgets.QApplication.instance().quit)
