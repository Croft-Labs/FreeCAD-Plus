import os,sys,json,traceback,unittest,importlib
sys.dont_write_bytecode=True
from pathlib import Path
import FreeCAD as App,FreeCADGui as Gui
from PySide6 import QtCore,QtWidgets
out=Path(os.environ['PLUS_TEST_DIR'])
def run():
    result={'ok':False}
    try:
        from freecad_plus import ui_modes
        Gui.activateWorkbench('PartDesignWorkbench');ui_modes.apply_modes()
        win=Gui.getMainWindow();win.showNormal();win.resize(1750,1250);win.show()
        source=Path('C:/Users/dgium/Documents/__Apps/FreeCAD/FreeCAD-Plus/src/Mod/FreeCADPlus')
        if os.environ['PLUS_TEST_PHASE']=='source':
            sys.path.insert(0,str(source))
            import freecad_plus
            freecad_plus.__path__.insert(0,str(source/'freecad_plus'))
            for name in ('document','editing','history_appearance_ui'):
                importlib.reload(importlib.import_module('freecad_plus.'+name))
        if os.environ['PLUS_TEST_PHASE']!='baseline':
            from freecad_plus import reference_image,reference_image_task,reference_image_ui
            reference_image_task.install()
            result['modules']={m.__name__:m.__file__ for m in (reference_image,reference_image_task,reference_image_ui)}
        names=os.environ.get('PLUS_TEST_NAMES','').split(',')
        suite=unittest.TestSuite(unittest.defaultTestLoader.loadTestsFromName(n) for n in names if n)
        with (out/'tests.txt').open('w') as stream:r=unittest.TextTestRunner(stream=stream,verbosity=2).run(suite)
        result.update(ok=r.wasSuccessful(),tests=r.testsRun,errors=len(r.errors),failures=len(r.failures))
    except BaseException:result['error']=traceback.format_exc()
    (out/'result.json').write_text(json.dumps(result,indent=2))
    for name in list(App.listDocuments()):App.closeDocument(name)
    QtCore.QTimer.singleShot(100,QtWidgets.QApplication.quit)
QtCore.QTimer.singleShot(1600,run)
