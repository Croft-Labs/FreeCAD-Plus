import os,json,traceback
from pathlib import Path
import FreeCAD as App,FreeCADGui as Gui
from PySide6 import QtCore,QtWidgets,QtTest
from freecad_plus import sketch_pattern_edit as editing
out=Path(os.environ['PLUS_TEST_DIR'])

def run():
    result={'ok':False,'files':[]}
    try:
        Gui.activateWorkbench('SketcherWorkbench')
        files=[out.parent/'installed/edited-pattern.FCStd',out.parent/'installed/external-pattern.FCStd',
               out.parents[1]/'pattern-group-20261124/installed/fixed-line-grid12.FCStd',
               out.parents[1]/'pattern-group-20261124/installed/grid12.FCStd']
        for path in files:
            doc=App.openDocument(str(path));s=doc.Sketch
            group=next(c.PatternGroup for c in s.Constraints if c.PatternGroup)
            record,ids,options=editing.load(s,group)
            old=len(record['instances']);source=[s.Geometry[i].Tag for i in ids]
            Gui.activeDocument().setEdit(s.Name);QtTest.QTest.qWait(100)
            rows=Gui.getMainWindow().findChild(QtWidgets.QListWidget,'listWidgetConstraints')
            row=next(rows.item(i) for i in range(rows.count()) if not rows.item(i).isHidden() and rows.item(i).text().startswith('Pattern'))
            rows.scrollToItem(row);position=rows.visualItemRect(row).center()
            QtTest.QTest.mouseClick(rows.viewport(),QtCore.Qt.LeftButton,pos=position)
            QtTest.QTest.mouseDClick(rows.viewport(),QtCore.Qt.LeftButton,pos=position);QtTest.QTest.qWait(200)
            panel=Gui.getMainWindow().findChild(QtWidgets.QWidget,'SketchPatternPanel')
            assert panel is not None and panel.edit_group==group
            assert panel.apply.isEnabled(),panel.status.text()
            newcount=panel.d1.count.value()+1
            panel.d1.count.setValue(newcount);panel.done.click();QtTest.QTest.qWait(100)
            updated,newids,newoptions=editing.load(s,group)
            assert s.solve()==0 and len(updated['instances'])>old
            assert [s.Geometry[i].Tag for i in newids]==source
            assert newoptions['d1']['count']==newcount
            Gui.activeDocument().resetEdit()
            saved=out/(path.stem+'-updated.FCStd');doc.saveAs(str(saved));App.closeDocument(doc.Name)
            doc=App.openDocument(str(saved));assert doc.Sketch.solve()==0
            assert editing.load(doc.Sketch,group)[2]['d1']['count']==newcount
            App.closeDocument(doc.Name)
            result['files'].append(dict(file=path.name,recovered=bool(record.get('recovered')),count=newcount))
        result['ok']=True
    except BaseException:result['error']=traceback.format_exc()
    (out/'result.json').write_text(json.dumps(result,indent=2))
    (out/'tests.txt').write_text('Fresh-process current and legacy pattern task edits: '+str(result['ok']))
    for name in list(App.listDocuments()):App.closeDocument(name)
    QtCore.QTimer.singleShot(100,Gui.getMainWindow().close)
QtCore.QTimer.singleShot(2000,run)
