import os,json,traceback
from pathlib import Path
import FreeCAD as App,FreeCADGui as Gui
from PySide6 import QtCore
out=Path(os.environ['PLUS_TEST_DIR'])
def run():
    result={'ok':False}
    try:
        from freecad_plus import document
        doc=document.open_document(out/'TwoBodyShell.cadprt');names=json.loads((out/'fixture.json').read_text())
        feature=doc.getObject(names['feature']);feature.touch();doc.recompute()
        assert feature.ID==names['identity'] and feature.Shape.isValid()
        assert abs(feature.Shape.Volume-names['volume'])<1e-7
        assert feature.getParentGeoFeatureGroup()==doc.getObject(names['first'])
        assert doc.getObject(names['second']).Tip==doc.getObject(names['second_solid'])
        assert abs(doc.getObject(names['second_solid']).Shape.Volume-480)<1e-7
        result.update(ok=True,identity=feature.ID,volume=feature.Shape.Volume)
    except BaseException:result['error']=traceback.format_exc()
    (out/'reopen.json').write_text(json.dumps(result,indent=2))
    for name in list(App.listDocuments()):App.closeDocument(name)
    QtCore.QTimer.singleShot(100,Gui.getMainWindow().close)
QtCore.QTimer.singleShot(2200,run)
