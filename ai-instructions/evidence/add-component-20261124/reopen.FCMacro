import json,os,traceback
from pathlib import Path
import FreeCAD as App,FreeCADGui as Gui
from PySide6 import QtCore,QtTest
out=Path(os.environ['PLUS_TEST_DIR'])
def run():
    result={'ok':False}
    try:
        from freecad_plus import document,editing,panel,component_add
        cases=(('test_new_child_is_atomic_and_standalone_new_component_remains_unplaced','DomesticChild.cadprt'),
               ('test_loaded_file_import_and_child_are_one_undo_and_save_reopen','Host.cadprt'))
        checked=[]
        for folder_name,filename in cases:
            folder=out.parent/'installed'/folder_name
            expected=json.loads((folder/'expected.json').read_text())
            doc=document.open_document(folder/filename)
            assert {o.Name:o.ID for o in doc.Objects}==expected['ids']
            assert abs(doc.getObject(expected['pad']).Shape.Volume-expected['volume'])<1e-8
            child=doc.getObject(expected['child']);link=doc.getObject(expected['link'])
            assert link in child.Group
            if 'source_uid' in expected:
                assert str(link.LinkedObject.Document.Uid)==expected['source_uid']
                assert link.LinkedObject.Name==expected['source_part']
            else:assert link.LinkedObject.Name==expected['definition']
            first=document.validate(doc).Group[0]
            nested=next(o for o in first.LinkedObject.Group if o.TypeId=='App::Link' and o.LinkedObject==child)
            editing.edit((first,nested));QtTest.QTest.qWait(100)
            widget=panel.show_panel();widget.refresh();widget.activate_assembly(first.LinkedObject)
            before={o.Name:o.ID for o in doc.Objects};_,token=component_add.target()
            added=component_add.add(token,label='Reopened addition')
            assert added in child.Group
            doc.undo();doc.recompute();assert {o.Name:o.ID for o in doc.Objects}==before
            widget.grab().save(str(out/(filename+'-assembly.png')))
            checked.append(filename)
            for name in list(App.listDocuments()):App.closeDocument(name)
            QtTest.QTest.qWait(150)
        result.update(ok=True,checks=checked,verified=['native IDs','geometry volume','child links','external source identity','add then Undo after reopen'])
    except BaseException:result['error']=traceback.format_exc()
    (out/'result.json').write_text(json.dumps(result,indent=2))
    for name in list(App.listDocuments()):App.closeDocument(name)
    QtCore.QTimer.singleShot(100,Gui.getMainWindow().close)
QtCore.QTimer.singleShot(2200,run)
