import json,os,traceback
from pathlib import Path
import FreeCAD as App,FreeCADGui as Gui
from PySide6 import QtCore,QtTest
out=Path(os.environ['PLUS_TEST_DIR'])
def run():
    result={'ok':False}
    try:
        from freecad_plus import document,editing,panel,assembly
        folder=out.parent/'installed/test_per_view_choice_and_saved_reopen_preference'
        expected=json.loads((folder/'expected.json').read_text())
        doc=document.open_document(folder/'Assembly.cadprt')
        assert str(doc.Uid)==expected['uid']
        assert {o.Name:o.ID for o in doc.Objects}==expected['ids']
        assert abs(doc.getObject(expected['pad']).Shape.Volume-expected['volume'])<1e-8
        owner=doc.getObject(expected['part'])
        assert assembly.recalled(doc)==owner
        widget=panel.show_panel();widget.refresh();QtTest.QTest.qWait(100)
        assert widget.trees[1].topLevelItem(0).data(0,panel._ROLE).ref==panel.identity(owner)
        widget.tabs.setCurrentIndex(1)
        assert widget.grab().save(str(out/'reopened-assembly.png'))
        result.update(ok=True,checks=['persistent workspace choice','native identity and volume','selected part root after reopen'],module=panel.__file__)
    except BaseException:result['error']=traceback.format_exc()
    (out/'result.json').write_text(json.dumps(result,indent=2))
    for name in list(App.listDocuments()):App.closeDocument(name)
    QtCore.QTimer.singleShot(100,Gui.getMainWindow().close)
QtCore.QTimer.singleShot(2200,run)
