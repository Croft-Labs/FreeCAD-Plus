import os,sys,json,traceback
sys.dont_write_bytecode=True
from pathlib import Path
import FreeCAD as App,FreeCADGui as Gui
from PySide6 import QtCore
out=Path(os.environ['PLUS_TEST_DIR'])
def run():
    result={'ok':False}
    try:
        from freecad_plus import thicken,thicken_task,extrude_task,document,editing,isolation
        Gui.activateWorkbench('PartDesignWorkbench')
        doc=document.open_document(out/'InstalledThicken.cadprt');names=json.loads((out/'fixture.json').read_text())
        feature=doc.getObject(names['feature']);sheet=doc.getObject(names['sheet'])
        assert feature.ID==names['identity'] and thicken.settings(feature)['thickness']==2
        assert abs(feature.Shape.Volume-names['volume'])<1e-7
        sheet.Placement.Base.y=5;feature.touch();doc.recompute()
        assert feature.Shape.isValid() and not feature.ThickenError and len(feature.Shape.Solids)==1
        assert abs(feature.Shape.BoundBox.YMin-5)<1e-7 and abs(feature.Shape.BoundBox.YMax-20)<1e-7
        definition=thicken.owner(feature);occurrences=isolation.occurrences(doc,definition)
        if occurrences:editing.edit(occurrences[0])
        else:editing.edit_unused(doc,definition)
        task=thicken_task.show(feature);assert task.valid and task.refs==[(sheet,'')];task.reject()
        result.update(ok=True,fresh_process_recompute=True,identity=feature.ID,volume=feature.Shape.Volume,profile=App.ConfigGet('UserParameter'))
    except BaseException:result['error']=traceback.format_exc()
    (out/'reopen.json').write_text(json.dumps(result,indent=2))
    from freecad_plus import extrude_task
    if extrude_task._active:extrude_task._active.reject()
    for name in list(App.listDocuments()):App.closeDocument(name)
    QtCore.QTimer.singleShot(100,Gui.getMainWindow().close)
QtCore.QTimer.singleShot(2200,run)
