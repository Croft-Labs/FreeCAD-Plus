import json, os, sys, traceback
sys.dont_write_bytecode=True
from pathlib import Path
import FreeCAD as App, FreeCADGui as Gui
from PySide6 import QtCore
from freecad_plus import document
out=Path(os.environ['PLUS_TEST_DIR'])

def run():
    result={'ok':False}
    try:
        doc=document.open_document(out/'Protected.cadprt')
        expected=json.loads((out/'expected.json').read_text())
        assert {o.Name:[o.ID,o.Visibility] for o in doc.Objects}==expected
        root=document.validate(doc);attempts=[]
        for owner in [root,*root.Definitions,*[o for o in doc.Objects if o.TypeId=='PartDesign::Body']]:
            for obj in [owner.Origin,*owner.Origin.OriginFeatures]:
                name=obj.Name
                try:doc.removeObject(name)
                except RuntimeError as error:assert 'base coordinate system' in str(error)
                else:raise AssertionError('Deletion was allowed: '+name)
                attempts.append(name)
        assert {o.Name:[o.ID,o.Visibility] for o in doc.Objects}==expected
        result.update(ok=True,protected_objects=attempts,identities_and_visibility_preserved=True)
    except BaseException:result['error']=traceback.format_exc()
    (out/'reopen.json').write_text(json.dumps(result,indent=2))
    for name in list(App.listDocuments()):App.closeDocument(name)
    QtCore.QTimer.singleShot(100,Gui.getMainWindow().close)
QtCore.QTimer.singleShot(2200,run)
