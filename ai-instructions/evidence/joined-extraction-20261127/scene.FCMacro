import os,sys,json,traceback,unittest,importlib
sys.dont_write_bytecode=True
from pathlib import Path
import FreeCAD as App,FreeCADGui as Gui
from PySide6 import QtCore,QtWidgets
out=Path(os.environ['PLUS_TEST_DIR'])

def run():
    result={'ok':False}
    try:
        from freecad_plus import panel,ui_modes
        Gui.activateWorkbench('PartDesignWorkbench');ui_modes.apply_modes()
        Gui.getMainWindow().showNormal();Gui.getMainWindow().resize(1400,980);Gui.getMainWindow().show()
        source=Path('C:/Users/dgium/Documents/__Apps/FreeCAD/FreeCAD-Plus/src/Mod/FreeCADPlus')
        sys.path.insert(0,str(source))
        from freecad_plus import derived_geometry,clone_ui,clone_task
        if os.environ['PLUS_TEST_PHASE']=='source':
            import freecad_plus
            freecad_plus.__path__.insert(0,str(source/'freecad_plus'))
            for module in (derived_geometry,clone_ui,clone_task):importlib.reload(module)
        result['modules']={module.__name__:module.__file__ for module in (derived_geometry,clone_ui,clone_task)}
        names=os.environ.get('PLUS_TEST_NAMES','').split(',')
        if names==['reopen']:
            from freecad_plus import document,derived_geometry as derived
            fixtures=out.parent/'i1'
            files=[fixtures/'test_multiple_objects_placement_save_reopen_and_export/Joined.cadprt',
                   fixtures/'test_multiple_objects_placement_save_reopen_and_export/Exported.cadprt',
                   fixtures/'test_external_component_owns_join_and_repeated_occurrences/Host.cadprt']
            def check_file(path):
                doc=document.open_document(path)
                results=[o for d in App.listDocuments().values() for o in d.Objects if derived.is_derived(o) and derived.joined(o)]
                assert len(results)==1,(path,results)
                feature=results[0];assert len(derived.saved_refs(feature))==2
                feature.touch();feature.Document.recompute();doc.recompute()
                assert not feature.GeometryError and feature.Shape.isValid() and len(feature.Shape.Faces)==2
                document.validate(doc)
                for name in list(App.listDocuments()):App.closeDocument(name)
            suite=unittest.TestSuite(unittest.FunctionTestCase(lambda path=path:check_file(path),description=path.name) for path in files)
        else:
            suite=unittest.TestSuite(unittest.defaultTestLoader.loadTestsFromName(name) for name in names if name)
        with (out/'tests.txt').open('w') as stream:r=unittest.TextTestRunner(stream=stream,verbosity=2).run(suite)
        result.update(ok=r.wasSuccessful(),tests=r.testsRun,errors=len(r.errors),failures=len(r.failures))
    except BaseException:result['error']=traceback.format_exc()
    (out/'result.json').write_text(json.dumps(result,indent=2))
    for name in list(App.listDocuments()):App.closeDocument(name)
    QtCore.QTimer.singleShot(100,QtWidgets.QApplication.quit)
QtCore.QTimer.singleShot(2300,run)
