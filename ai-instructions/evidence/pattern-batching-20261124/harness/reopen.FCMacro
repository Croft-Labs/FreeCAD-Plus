import os,json,traceback
from pathlib import Path
import FreeCAD as App,FreeCADGui as Gui
from PySide6 import QtCore
from freecad_plus import sketch_pattern as pattern
out=Path(os.environ['PLUS_TEST_DIR'])
def run():
    try:
        doc=App.openDocument(str(out.parent/'installed/grid12.FCStd'))
        s=doc.getObject('Sketch')
        assert (s.GeometryCount,s.ConstraintCount)==(287,716)
        assert s.solve()==0
        before=s.DoF
        helpers={i for i in range(s.GeometryCount) if s.getConstruction(i)}
        assert len(helpers)==143 and len(s.PatternSpacingTags)==143
        for i in range(1,144):
            assert any(c.Type=='Equal' and {c.First,c.Second}=={0,i} for c in s.Constraints)
        masters=[i for i,c in enumerate(s.Constraints) if c.Type=='Distance']
        assert len(masters)==2
        s.setDatum(0,App.Units.Quantity('8 mm'))
        s.setDatum(masters[0],App.Units.Quantity('12 mm'))
        s.setDatum(masters[1],App.Units.Quantity('14 mm'))
        doc.recompute();assert s.solve()==0 and s.DoF==before
        origin=s.Geometry[0].Center
        for i in range(144):
            assert abs(s.Geometry[i].Radius-4)<1e-6
            assert (s.Geometry[i].Center-origin-App.Vector((i//12)*12,(i%12)*14,0)).Length<1e-5
        for hidden in (True,False):
            pattern.set_chain_hidden(s,hidden)
            assert pattern.chain_is_hidden(s)==hidden and s.solve()==0
        (out/'result.json').write_text(json.dumps(dict(ok=True,instances=144,equal_copies=143,
            spacing_lines=143,pitch_drivers=2,edited_after_reopen=True),indent=2))
        (out/'tests.txt').write_text('Fresh-process grid12 reopen, diameter/pitch edits and helper visibility passed.\n')
    except BaseException:
        (out/'result.json').write_text(json.dumps(dict(ok=False,error=traceback.format_exc())))
    for name in list(App.listDocuments()):App.closeDocument(name)
    QtCore.QTimer.singleShot(100,Gui.getMainWindow().close)
QtCore.QTimer.singleShot(1800,run)
