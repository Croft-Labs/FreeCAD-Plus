"""Independent Plus viewport category admission, intersected with native gates."""
import FreeCADGui as Gui
from PySide6 import QtCore, QtGui, QtWidgets

CATEGORIES = ('Planes', 'Bodies', 'Surfaces', 'Faces', 'Edges', 'Curves', 'Points', 'Vertices')
_controller = None


def preferences():
    from .selection_toolbar import preferences as selection_preferences
    return selection_preferences().GetGroup('Categories')


def category(root, subname):
    """Classify the native geometry owner without following dependency graphs."""
    import Part
    prefix, _, _ = Part.splitSubname(subname or '')
    owner = root.getSubObject(prefix, 1) if prefix else root
    if owner is None:
        return None
    owner = owner.getLinkedObject(True)
    element = Part.splitSubname(root.resolveSubElement(subname or '')[2])[2]
    kind = owner.TypeId
    if kind in ('App::Plane', 'PartDesign::Plane', 'Part::DatumPlane'):
        return 'Planes'
    if kind in ('App::Origin', 'PartDesign::Point', 'Part::DatumPoint'):
        return 'Points'
    if owner.isDerivedFrom('Sketcher::SketchObject'):
        if element.startswith('Constraint'):
            return None  # Constraint editing remains a native Sketcher operation.
        if element.startswith('Vertex') or element == 'RootPoint':
            return 'Points'
        if element in ('H_Axis', 'V_Axis'):
            return None
        return 'Curves'
    if not hasattr(owner, 'Shape'):
        return None  # Preserve workbench-specific objects outside this taxonomy.
    shape = owner.Shape
    if shape.isNull():
        return None
    if shape.Solids:
        for prefix, result in (('Face', 'Faces'), ('Edge', 'Edges'), ('Vertex', 'Vertices')):
            if element.startswith(prefix):
                return result
        return 'Bodies'
    if shape.Faces:
        return 'Surfaces'
    if element.startswith('Vertex') or not shape.Edges:
        return 'Points'
    return 'Curves'


class Controller(QtCore.QObject):
    def __init__(self):
        super().__init__(Gui.getMainWindow())
        self.active = False
        self.enabled = {}
        self.cache = {}
        QtWidgets.QApplication.instance().installEventFilter(self)

    def configure(self, active):
        self.enabled = {name: preferences().GetBool(name, True) for name in CATEGORIES}
        if active != self.active:
            Gui.Selection.setPlusSelectionGate(self if active else None)
        self.active = active
        self.end_pick()

    def eventFilter(self, watched, event):
        if self.active and event.type() in (QtCore.QEvent.MouseMove,
                                            QtCore.QEvent.MouseButtonPress,
                                            QtCore.QEvent.MouseButtonRelease):
            widget = watched if isinstance(watched, QtWidgets.QWidget) else None
            while widget is not None:
                if widget.inherits('Gui::View3DInventorViewer'):
                    Gui.getMainWindow().setProperty('FreeCADPlusCategoryPicking', True)
                    QtCore.QTimer.singleShot(0, self.end_pick)
                    break
                widget = widget.parentWidget()
        return False

    def end_pick(self):
        Gui.getMainWindow().setProperty('FreeCADPlusCategoryPicking', None)
        self.cache.clear()

    def allow(self, doc, root, sub):
        if all(self.enabled.values()):
            return True
        key = (doc.Name, root.Name, sub or '')
        if key not in self.cache:
            self.cache[key] = category(root, sub)
        return self.enabled.get(self.cache[key], True)


def apply(active):
    global _controller
    if _controller is None:
        _controller = Controller()
    _controller.configure(active)


def append_controls(row):
    # UI-only preview state. Native category admission is deliberately untouched.
    button = QtWidgets.QToolButton()
    button.setObjectName('PlusSelectionCategories')
    button.setAccessibleName('Selection categories')
    button.setIcon(Gui.getIcon('view-select'))
    button.setToolButtonStyle(QtCore.Qt.ToolButtonTextBesideIcon)
    button.setAutoRaise(True)
    button.setPopupMode(QtWidgets.QToolButton.InstantPopup)
    menu = QtWidgets.QMenu(button)
    panel = QtWidgets.QWidget()
    layout = QtWidgets.QVBoxLayout(panel)
    layout.setContentsMargins(12, 10, 12, 12)
    actions = QtWidgets.QHBoxLayout()
    reset = QtWidgets.QPushButton('Select all / reset')
    reset.setObjectName('SelectAllReset')
    select_one = QtWidgets.QPushButton('Select 1')
    select_one.setObjectName('SelectOneCategory')
    select_one.setCheckable(True)
    actions.addWidget(reset)
    actions.addWidget(select_one)
    layout.addLayout(actions)
    hint = QtWidgets.QLabel()
    hint.setWordWrap(True)
    hint.setFixedWidth(270)
    hint.setMinimumHeight(52)
    layout.addWidget(hint)
    boxes = {}
    state = {'enabled': set(CATEGORIES), 'armed': False}
    for name in CATEGORIES:
        box = QtWidgets.QCheckBox(name)
        box.setObjectName('Category' + name)
        boxes[name] = box
        layout.addWidget(box)
        box.clicked.connect(lambda checked, name=name: choose(name, checked))
    action = QtWidgets.QWidgetAction(menu)
    action.setDefaultWidget(panel)
    menu.addAction(action)

    def refresh():
        enabled = state['enabled']
        omitted = [name for name in CATEGORIES if name not in enabled]
        if not omitted:
            summary = 'All'
        elif len(enabled) == 1:
            summary = next(iter(enabled)) + ' only'
        elif len(omitted) == 1:
            summary = omitted[0] + ' omitted'
        else:
            summary = str(len(omitted)) + ' omitted'
        button.setText(summary)
        button.setToolTip('Selection categories: ' + summary + '\nAllowed: ' +
                          ', '.join(n for n in CATEGORIES if n in enabled))
        for name, box in boxes.items():
            box.setChecked(name in enabled)
            box.setEnabled(state['armed'] or len(enabled) > 1 or name not in enabled)
        select_one.setChecked(state['armed'])
        if state['armed']:
            hint.setText('Choose one category below. Click outside to keep the current filter.')
            hint.setStyleSheet('QLabel { background: #fff0bf; color: #604300; border: 1px solid #c78a20; padding: 6px; }')
        else:
            hint.setText('At least one category must stay selected.' if len(enabled) == 1
                         else 'Choose which geometry can be selected.')
            hint.setStyleSheet('')

    def choose(name, checked):
        armed = state['armed']
        if armed:
            state['enabled'] = {name}
            state['armed'] = False
        elif checked:
            state['enabled'].add(name)
        elif len(state['enabled']) > 1:
            state['enabled'].discard(name)
        refresh()
        if armed:
            menu.close()

    def reset_all():
        state.update(enabled=set(CATEGORIES), armed=False)
        refresh()

    def arm(checked):
        state['armed'] = checked
        refresh()

    def dismiss():
        state['armed'] = False
        refresh()

    reset.clicked.connect(reset_all)
    select_one.clicked.connect(arm)
    menu.aboutToHide.connect(dismiss)
    button.setMenu(menu)
    refresh()
    row.addWidget(button)
