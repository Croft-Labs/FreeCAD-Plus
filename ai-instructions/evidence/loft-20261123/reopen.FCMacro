import os,json,traceback
from pathlib import Path
import FreeCAD as App,FreeCADGui as Gui
from PySide6 import QtCore
out=Path(os.environ['PLUS_TEST_DIR'])
def run():
    result={'ok':False}
    try:
        from freecad_plus import document,loft
        expected=json.loads((out/'fixture.json').read_text());doc=document.open_document(out/'Loft.cadprt')
        feature=doc.getObject(expected['feature']);cut=doc.getObject(expected['cut'])
        feature.touch();cut.touch();doc.recompute()
        assert feature.ID==expected['identity'] and feature.Shape.isValid() and not feature.Shape.Solids
        assert abs(feature.Shape.Area-expected['area'])<1e-6
        assert cut.Shape.isValid() and abs(cut.Shape.Volume-expected['cut_volume'])<1e-6
        other=doc.getObject(expected['other']);assert other.getParentGeoFeatureGroup().Tip==other
        assert abs(other.Shape.Volume-expected['other_volume'])<1e-6
        result.update(ok=True,identity=feature.ID,sheet_area=feature.Shape.Area,subtract_volume=cut.Shape.Volume)
    except BaseException:result['error']=traceback.format_exc()
    (out/'reopen.json').write_text(json.dumps(result,indent=2))
    for name in list(App.listDocuments()):App.closeDocument(name)
    QtCore.QTimer.singleShot(100,Gui.getMainWindow().close)
QtCore.QTimer.singleShot(2200,run)
