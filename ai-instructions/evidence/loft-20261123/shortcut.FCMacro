import os,json,traceback
from pathlib import Path
import FreeCAD as App,FreeCADGui as Gui
from PySide6 import QtCore
out=Path(os.environ['PLUS_TEST_DIR'])
def run():
    result={'ok':False}
    case=None
    try:
        import TestLoftWorkflow
        assert 'profile-shortcut' in App.ConfigGet('UserParameter')
        assert 'profile-shortcut' in App.ConfigGet('SystemParameter')
        assert 'profile-shortcut' in App.getUserAppDataDir()
        assert '/app/' in TestLoftWorkflow.__file__.replace('\\','/')
        win=Gui.getMainWindow();win.show();win.raise_();win.activateWindow()
        case=TestLoftWorkflow.TestLoftWorkflow('test_native_and_plus_command_dispatch_no_active_body')
        case.setUp();case.test_native_and_plus_command_dispatch_no_active_body()
        result.update(ok=True,module=TestLoftWorkflow.__file__,profile=App.ConfigGet('UserParameter'),loft_command_dispatch=True)
    except BaseException:result['error']=traceback.format_exc()
    finally:
        if case:case.tearDown()
    (out/'shortcut.json').write_text(json.dumps(result,indent=2))
QtCore.QTimer.singleShot(2200,run)
