import json,os,sys,traceback,unittest,importlib,tempfile
sys.dont_write_bytecode=True
from pathlib import Path
import FreeCAD as App,FreeCADGui as Gui
from PySide6 import QtCore,QtWidgets
out=Path(os.environ['PLUS_TEST_DIR'])
class LiveResult(unittest.TextTestResult):
    def startTest(self,test):
        QtWidgets.QApplication.setActiveWindow(Gui.getMainWindow())
        super().startTest(test);self.stream.flush()
    def addError(self,test,err):
        super().addError(test,err);self.stream.write(self._exc_info_to_string(err,test));self.stream.flush()
    def addFailure(self,test,err):
        super().addFailure(test,err);self.stream.write(self._exc_info_to_string(err,test));self.stream.flush()

def run():
    result={'ok':False}
    try:
        win=Gui.getMainWindow();win.resize(1100,800);win.show();win.raise_();win.activateWindow()
        Gui.activateWorkbench('PartDesignWorkbench')
        os.environ['PLUS_TEST_DIR']=tempfile.mkdtemp(prefix='fresh-',dir=out)
        scope=os.environ['PLUS_TEST_SCOPE']
        suite=unittest.TestSuite()
        modules=['TestTaskEntryWorkflows'] if scope=='repair' else [
            'TestTaskEntryWorkflows','TestExtrudeWorkflow','TestRevolveWorkflow',
            'TestDesignInteractions','TestPlaneHistoryWorkflow','TestExtrudeVisibility']
        import TestComponentPanel
        classes = ([TestComponentPanel.TestUIModes] if scope=='ui' else
                   [TestComponentPanel.TestNativeComponentCreation] if scope=='repair' else
                   [TestComponentPanel.TestComponentPanel, TestComponentPanel.TestNativeComponentCreation,
                    TestComponentPanel.TestUIModes, TestComponentPanel.TestHistoryVisibility])
        for cls in classes:suite.addTests(unittest.defaultTestLoader.loadTestsFromTestCase(cls))
        if scope!='ui':
            for name in modules:
                module=importlib.import_module(name)
                suite.addTests(unittest.defaultTestLoader.loadTestsFromTestCase(getattr(module,name)))
        with (out/'regression.txt').open('w') as stream:
            report=unittest.TextTestRunner(stream=stream,verbosity=2,resultclass=LiveResult).run(suite)
        from freecad_plus import task_status,plane_task,extrude_task
        result.update(ok=report.wasSuccessful(),tests=report.testsRun,failures=len(report.failures),errors=len(report.errors),
                      modules={name:module.__file__ for name,module in (
                          ('status',task_status),('plane',plane_task),('extrude',extrude_task))})
    except BaseException:result['error']=traceback.format_exc()
    (out/'regression.json').write_text(json.dumps(result,indent=2))
    for name in list(App.listDocuments()):App.closeDocument(name)
    QtCore.QTimer.singleShot(100,Gui.getMainWindow().close)
QtCore.QTimer.singleShot(2200,run)
