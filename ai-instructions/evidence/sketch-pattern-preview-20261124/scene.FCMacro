import os, sys, json, traceback, shutil
from pathlib import Path
import FreeCAD as App, FreeCADGui as Gui, Part
from PySide6 import QtCore, QtWidgets, QtTest
sys.dont_write_bytecode = True
out = Path(os.environ['PLUS_PREVIEW_OUT'])

def run():
    result = {'ok': False, 'ui_only': True}
    try:
        win = Gui.getMainWindow(); win.showNormal(); win.resize(1400, 1100)
        Gui.activateWorkbench('SketcherWorkbench')
        doc = App.newDocument('PatternPreview')
        sketch = doc.addObject('Sketcher::SketchObject', 'Sketch')
        for a,b in (((5,3),(15,3)), ((15,3),(15,11)), ((15,11),(5,11))):
            sketch.addGeometry(Part.LineSegment(App.Vector(*a,0), App.Vector(*b,0)), False)
        doc.recompute(); Gui.activeDocument().setEdit(sketch.Name)
        QtTest.QTest.qWait(150)
        view = Gui.activeDocument().activeView(); view.setAnimationEnabled(False); view.viewTop(); view.fitAll()
        for i in range(1,4): Gui.Selection.addSelection(sketch, 'Edge'+str(i))
        Gui.runCommand('Sketcher_Translate'); QtTest.QTest.qWait(200)
        dock = win.findChild(QtWidgets.QDockWidget, 'Tasks'); dock.setMinimumWidth(470)
        sys.path.insert(0, os.environ['PLUS_PREVIEW_WORKTREE']); import pattern_ui
        panel = pattern_ui.install(dock)
        before = sketch.GeometryCount
        def shot(name):
            for scroll in dock.findChildren(QtWidgets.QScrollArea): scroll.verticalScrollBar().setValue(0)
            QtTest.QTest.qWait(100); dock.grab().save(str(out/(name+'.png')))
        if panel is None:
            shot('baseline'); shutil.copyfile(out/'baseline.png', os.environ['PLUS_PREVIEW_IMAGE'])
        else:
            assert not panel.apply.isEnabled(); shot('empty')
            panel.add_geometry('Edge1'); panel.add_geometry('Edge2'); panel.add_geometry('Edge3')
            panel.add_geometry('Edge1'); assert panel.items.count() == 3
            panel.add_geometry('Edge2', True); assert panel.items.count() == 2
            panel.add_geometry('Edge2')
            panel.d1.reference.setText('Horizontal sketch axis'); panel.sync()
            assert panel.apply.isEnabled(); shot('linear-one')
            panel.layout_mode.setCurrentIndex(1)
            panel.d1.extent.setCurrentIndex(1); panel.d1.count.setValue(5); panel.d1.count2.setValue(3)
            panel.d2.reference.setText('Vertical sketch axis'); panel.d2.extent.setCurrentIndex(1)
            panel.d2.count.setValue(4); panel.d2.count2.setValue(2)
            panel.d2.spacing.setCurrentIndex(1); panel.d2.value.setValue(30); panel.d2.value2.setValue(15); panel.sync()
            assert panel.apply.isEnabled(); shot('linear-grid')
            assert panel.d1.total()==7 and panel.d2.total()==5
            shutil.copyfile(out/'linear-grid.png', os.environ['PLUS_PREVIEW_IMAGE'])
            panel.d2.extent.setCurrentIndex(2)
            assert not panel.apply.isEnabled(); shot('invalid-count')
            panel.d2.count.setValue(5); assert panel.apply.isEnabled()
            shot('linear-symmetric')
            panel.d1.method.setCurrentIndex(1); panel.d1.start.setText('Vertex1'); panel.d1.end.setText('Vertex4')
            panel.sync(); shot('two-points')
            panel.mode.setCurrentIndex(1); panel.center.setText('Arc1 — center'); panel.sync()
            panel.angular.spacing.setCurrentIndex(1); panel.angular.value.setValue(360); panel.angular.count.setValue(6)
            assert panel.apply.isEnabled(); shot('circular-total')
            panel.angular.spacing.setCurrentIndex(0); panel.angular.value.setValue(30)
            panel.angular.extent.setCurrentIndex(1); panel.angular.count.setValue(5); panel.angular.count2.setValue(3)
            panel.angular.value2.setValue(20)
            panel.layout_mode.setCurrentIndex(2); panel.radial.reference.setText('Circle2 — center')
            panel.radial.extent.setCurrentIndex(1); panel.radial.count.setValue(3); panel.radial.count2.setValue(2)
            panel.radial.value.setValue(10); panel.radial.value2.setValue(5)
            assert panel.apply.isEnabled(); shot('circular-radial')
            panel.layout_mode.setCurrentIndex(1); panel.radial.extent.setCurrentIndex(2); panel.radial.count.setValue(5)
            assert panel.apply.isEnabled(); shot('radial-symmetric')
            panel.apply.click(); assert panel.items.count()==0 and not panel.apply.isEnabled()
            shot('after-apply')
            panel.done.click(); QtTest.QTest.qWait(100)
            assert Gui.activeDocument().getInEdit() is not None
            assert all(w.isHidden()!=visible for w,visible in panel.hidden_sections)
            shot('after-done')
            result.update(empty_disabled=True,duplicate_add_noop=True,shift_removes=True,
                          linear_and_circular_states=True,symmetric_even_count_rejected=True,
                          apply_clears_geometry=True,done_restores_sections=True)
        assert sketch.GeometryCount == before
        result.update(ok=True, geometry_unchanged=True, proposed=pattern_ui.proposed())
        cancel = win.findChild(QtWidgets.QPushButton, 'SketchCancelAction')
        if cancel and cancel.isVisible(): cancel.click()
        Gui.activeDocument().resetEdit(); App.closeDocument(doc.Name)
    except BaseException:
        result['error'] = traceback.format_exc()
    (out/'result.json').write_text(json.dumps(result, indent=2))
    QtCore.QTimer.singleShot(100, Gui.getMainWindow().close)
QtCore.QTimer.singleShot(2200, run)
