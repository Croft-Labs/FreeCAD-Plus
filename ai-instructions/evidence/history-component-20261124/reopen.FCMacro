import json,os,sys,traceback
from pathlib import Path
import FreeCAD as App,FreeCADGui as Gui
from PySide6 import QtCore,QtTest
out=Path(os.environ['PLUS_TEST_DIR'])
def run():
    result={'ok':False}
    try:
        from freecad_plus import document,editing,panel
        import TestComponentRename
        prior=out.parent/'installed'
        TestComponentRename.verify_fresh_process(prior)
        folder=prior/'test_history_heading_context_menu_rename_undo_and_save'
        expected=json.loads((folder/'expected.json').read_text())
        doc=document.open_document(folder/'HistoryRename.cadprt')
        assert {o.Name:o.ID for o in doc.Objects}==expected['ids']
        owner=doc.getObject(expected['definition']);assert owner.Label==expected['label']
        assert abs(doc.getObject(expected['pad']).Shape.Volume-expected['volume'])<1e-8
        first=document.validate(doc).Group[0]
        nested=next(link for link in first.LinkedObject.Group if link.TypeId=='App::Link' and link.LinkedObject==owner)
        editing.edit((first,nested))
        widget=panel.show_panel();widget.tabs.setCurrentIndex(2);widget.refresh();QtTest.QTest.qWait(100)
        assert widget.trees[2].topLevelItem(0).text(0)==expected['label']
        assert widget.grab().save(str(out/'reopened-history.png'))
        result.update(ok=True,checks=['shared definition rename reopen','external definition rename reopen','History rename identity and volume','History heading after reopen'],module=panel.__file__)
    except BaseException:result['error']=traceback.format_exc()
    (out/'result.json').write_text(json.dumps(result,indent=2))
    for name in list(App.listDocuments()):App.closeDocument(name)
    QtCore.QTimer.singleShot(100,Gui.getMainWindow().close)
QtCore.QTimer.singleShot(2200,run)
